# === Telegram ===
# Token from @BotFather. NEVER commit the real value.
BOT_TOKEN=
BOT_NAME=Germany Assistant
# Your Telegram numeric ID(s), comma-separated. Find yours via @userinfobot
ADMIN_IDS=

# Languages offered in the bot (add de after creating app/i18n/locales/de.json)
LANGUAGES=uk,ru
DEFAULT_LANGUAGE=uk

# === Database ===
# Local without Docker:   sqlite+aiosqlite:///./data/bot.db
# Docker / production:    postgresql+asyncpg://bot:bot@db:5432/bot
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Optional. If empty, FSM state is kept in memory (lost on restart).
REDIS_URL=

# === Mini App ===
# Public HTTPS URL where the Mini App is served (Telegram requires HTTPS).
# Leave empty to run the bot without the Mini App button.
WEBAPP_URL=
RUN_WEBAPP=true
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# === Limits & privacy ===
RATE_LIMIT_PER_MINUTE=20
MAX_FILE_SIZE_MB=10
# Random secret for pseudonymous analytics hashes, e.g. `openssl rand -hex 32`
ANALYTICS_SALT=change-me

# === AI (stage B) ===
# none = not connected; bot will say so honestly instead of inventing answers.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

LOG_LEVEL=INFO

# Optional proxy for Telegram API calls
TELEGRAM_PROXY=
